# ---------------------------------------------------------------
# MTM Hackathon — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# --- Groq (recommended — fast cloud inference, no local install) ---
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b
# Other available models: allam-2-7b, openai/gpt-oss-20b, openai/gpt-oss-120b

# --- Backend selection (optional override) ---
# Allowed values: groq | ollama | openai | anthropic
# If not set, config.py auto-detects: groq > openai > anthropic > ollama
# LLM_BACKEND=groq

# --- Ollama (local fallback, no API key required) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# --- OpenAI (optional cloud alternative) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional cloud alternative) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307
