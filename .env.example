# ---------------------------------------------------------------
# MTM Hackathon — environment variable template
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ---------------------------------------------------------------

# --- Ollama (local model, no API key required) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Backend selection (optional) ---
# Allowed values: ollama | openai | anthropic
# If not set, config.py auto-detects based on which API key is present.
# LLM_BACKEND=ollama

# --- OpenAI (optional cloud alternative) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (optional cloud alternative) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307
